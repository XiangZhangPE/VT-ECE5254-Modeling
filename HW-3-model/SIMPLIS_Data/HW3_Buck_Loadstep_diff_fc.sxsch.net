*#SIMETRIX
.node_map io1 127
.node_map io2 131
.node_map io3 135
.node_map Vc1 130
.node_map Vc2 134
.node_map Vc3 138
.node_map Vp1 129
.node_map Vp2 133
.node_map Vp3 137
.node_map Vout1 128
.node_map Vout2 132
.node_map Vout3 136
.ac DEC 100 100 1Meg
.print
+ ALL
.options
+ PSP_START=3m
+ PSP_NPT=2001
+ POP_ITRMAX=200
+ POP_OUTPUT_CYCLES=5
+ SNAPSHOT_INTVL=0
+ MIN_AVG_TOPOLOGY_DUR=1a
+ AVG_TOPOLOGY_DUR_MEASUREMENT_WINDOW=128
.pop
+ TRIG_GATE={TRIG_GATE}
+ TRIG_COND=0_TO_1
+ MAX_PERIOD=10u
+ CONVERGENCE=10f
+ CYCLES_BEFORE_LAUNCH=100
+ TD_RUN_AFTER_POP_FAILS=-1
*.tran 20m 0


C 128 64 1m IC=1.8
C10 97 96 62.89p IC=0
C11 96 138 1.12p IC=0
C12 95 138 125p IC=0

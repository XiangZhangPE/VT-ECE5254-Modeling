L 59 60 150n
L1 74 75 150n
L2 88 89 150n
.PRINT V(#Vout1)
.PRINT V(#io1)
.GRAPH "db(:#Vout1/:#io1)" Curvelabel="GZo_fc80kHz" nowarn=true yunit="dB" complete=True analysis="ac" axisname=bodemag ylog=lin  persistence=0
.GRAPH "ph(-:#Vout1/:#io1)" Curvelabel="PZo_fc80kHz" nowarn=true yunit="degrees" complete=True analysis="ac"  axisname=bodephase ylog=lin  persistence=0
.PRINT V(#Vout2)
.PRINT V(#io2)
.GRAPH "db(:#Vout2/:#io2)" Curvelabel="GZo_fc1kHz" nowarn=true yunit="dB" complete=True analysis="ac" axisname=bodemag ylog=lin  persistence=0
.GRAPH "ph(-:#Vout2/:#io2)" Curvelabel="PZo_fc1kHz" nowarn=true yunit="degrees" complete=True analysis="ac"  axisname=bodephase ylog=lin  persistence=0

+ xLog="auto" yLog="lin"  nowarn=true disabled=false 
L1 19 20 150n
.PRINT V(#Vout)
.GRAPH :#Vout axisType="auto" persistence=-1 curveLabel="Vout" analysis="tran|pop"
+ xLog="auto" yLog="auto"  nowarn=true disabled=false PROBEREF=Probe3  
.PRINT V(#Vc)
.PRINT V(#Vout)
.GRAPH "db(:#Vc/:#Vout)" Curvelabel="Gc" nowarn=true yunit="dB" complete=True analysis="ac"
+ axisname=bodemag ylog=lin  persistence=0
.GRAPH "ph(-:#Vc/:#Vout)" Curvelabel="Pc" nowarn=true yunit="degrees" complete=True
+ analysis="ac"  axisname=bodephase ylog=lin  persistence=0
.PRINT V(#Vc)
.PRINT V(#Vp)
.GRAPH "db(:#Vc/:#Vp)" Curvelabel="T" nowarn=true yunit="dB" complete=True analysis="ac"
+ axisname=bodemag ylog=lin  persistence=0
.GRAPH "ph(-:#Vc/:#Vp)" Curvelabel="T" nowarn=true yunit="degrees" complete=True analysis="ac"
+  axisname=bodephase ylog=lin  persistence=0

* C:\Users\xiang\OneDrive - Virginia Tech\xiangzhang_VT_archive\ECE 5254 Modeling\HW-3-model\BuckBoost_CCM_Zo .sxsch
.node_map Vc 49
.node_map Vp 47
.node_map d 48
.node_map Vout 45
.node_map io 46
.ac DEC 25 100 500k
.print  ALL
.options PSP_START=3m PSP_NPT=10001 POP_ITRMAX=200 POP_OUTPUT_CYCLES=5 SNAPSHOT_INTVL=0
+ MIN_AVG_TOPOLOGY_DUR=1a AVG_TOPOLOGY_DUR_MEASUREMENT_WINDOW=128
.pop  TRIG_GATE=X1.!D_CYCLE  TRIG_COND=0_TO_1  MAX_PERIOD=1u  CONVERGENCE=10f  CYCLES_BEFORE_LAUNCH=200
+  TD_RUN_AFTER_POP_FAILS=0
C 45 27 1m IC=2
H1 46 0 VH1$TP_CCVS 1 
VH1$TP_CCVS 28 0 0
I2 45 28 AC 10m 0
V$IPROBE2 24 45 0.0
.PRINT I(V$IPROBE2)
.GRAPH IPROBE2#P axisType="grid" persistence=-1 curveLabel="IL" analysis="tran|pop"
+ xLog="auto" yLog="lin"  nowarn=true disabled=false 
L 22 23 150n
.PRINT V(#Vout)
.PRINT V(#io)
.GRAPH "db(:#Vout/:#io)" Curvelabel="Gain_Zo" nowarn=true yunit="dB" complete=True
+ analysis="ac" axisname=bodemag ylog=lin  persistence=0
.GRAPH "ph(-:#Vout/:#io)" Curvelabel="Phase_Zo" nowarn=true yunit="degrees" complete=True
+ analysis="ac"  axisname=bodephase ylog=lin  persistence=0
.PRINT V(#Vout)
.GRAPH :#Vout axisType="auto" persistence=-1 curveLabel="Vout" analysis="tran|pop"
+ xLog="auto" yLog="auto"  nowarn=true disabled=false PROBEREF=Probe3  
Rc 27 0 1m
Rl 24 23 2m
Ro 45 0 200m
X$S1 22 0 26 0 SIMPLIS_VC_SWITCH$1
X$S3 21 22 25 0 SIMPLIS_VC_SWITCH$2
X$U1 48 43 0 49 44 SIMPLIS_DIGI1_COMP_Y$3
X$U2 25 26 0 47 29 SIMPLIS_DIGI1_COMP_Y$4
V2 44 0 SAW V1=0 V2=1 FREQ=300000 DELAY=0 OFF_UNTIL_DELAY=NO
V3 49 0 250m
V6 47 0 167m
V7 29 0 SAW V1=0 V2=1 FREQ=1000000 DELAY=0 OFF_UNTIL_DELAY=NO
V8 21 0 12
X1 48 42 PERIODIC_OP$5
.subckt PERIODIC_OP$5  1 3
.NODE_MAP IN 1
.NODE_MAP OUT 3
!D_CYCLE 3 0 1 302 M1M IC=0
VREF 302 0 DC 2.5
.MODEL M1M COMP RIN=10MEG ROUT=50 VOL=0 VOH=5  HYSTWD=0.002 DELAY=0
.ends PERIODIC_OP$5

.subckt SIMPLIS_DIGI1_COMP_Y$4  201 202 100 101 102
.NODE_MAP OUT 201
.NODE_MAP OUT_BAR 202
.NODE_MAP RTN 100
.NODE_MAP INP 101
.NODE_MAP INN 102
R_INP  101 100 10000000
R_INN  102 100 10000000
E_DIFF 103 100 101 102 1.0
A_COMP %gnd_ref 100 [ 201 202 ] [ 103 ] MODEL=MD_A_COMPM IC=0
.MODEL MD_A_COMPM DIGITAL1 D_BUFFER ROUT=10 VOL=0 VOH=5  RIN=10000000 TH=0.0 HYSTWD=0.001
+  OUT_DELAY=2e-12
.ends SIMPLIS_DIGI1_COMP_Y$4

.subckt SIMPLIS_DIGI1_COMP_Y$3  201 202 100 101 102
.NODE_MAP OUT 201
.NODE_MAP OUT_BAR 202
.NODE_MAP RTN 100
.NODE_MAP INP 101
.NODE_MAP INN 102
R_INP  101 100 10000000
R_INN  102 100 10000000
E_DIFF 103 100 101 102 1.0
A_COMP %gnd_ref 100 [ 201 202 ] [ 103 ] MODEL=MD_A_COMPM IC=0
.MODEL MD_A_COMPM DIGITAL1 D_BUFFER ROUT=10 VOL=0 VOH=5  RIN=10000000 TH=0.0 HYSTWD=0.002
+  OUT_DELAY=2e-12
.ends SIMPLIS_DIGI1_COMP_Y$3

.subckt SIMPLIS_VC_SWITCH$2  1 2 3 4
.NODE_MAP P 1
.NODE_MAP N 2
.NODE_MAP CP 3
.NODE_MAP CN 4
S1 1 2 3 4 SW IC=OPEN
.MODEL SW VCSW ROFF=1000000 RON=1e-06 TH=2 HYSTWD=0.001 LOGIC=POS
.ends SIMPLIS_VC_SWITCH$2

.subckt SIMPLIS_VC_SWITCH$1  1 2 3 4
.NODE_MAP P 1
.NODE_MAP N 2
.NODE_MAP CP 3
.NODE_MAP CN 4
S1 1 2 3 4 SW IC=OPEN
.MODEL SW VCSW ROFF=1000000 RON=1e-06 TH=2 HYSTWD=0.001 LOGIC=POS
.ends SIMPLIS_VC_SWITCH$1

.end


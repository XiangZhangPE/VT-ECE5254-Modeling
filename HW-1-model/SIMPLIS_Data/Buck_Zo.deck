* C:\Users\xiang\Desktop\HW-1-model\Buck_Zo.sxsch
.node_map Vc 31
.node_map Vo 27
.node_map d 28
.node_map Vin 26
.node_map iL 30
.node_map io 29
.AC DEC 25 100 100k
.PRINT  ALL
.options PSP_START=3m PSP_NPT=10001 POP_ITRMAX=200 POP_OUTPUT_CYCLES=5 SNAPSHOT_INTVL=0
+ MIN_AVG_TOPOLOGY_DUR=1a AVG_TOPOLOGY_DUR_MEASUREMENT_WINDOW=128
.POP  TRIG_GATE=X1.!D_CYCLE  TRIG_COND=0_TO_1  MAX_PERIOD=10u  CONVERGENCE=10f  CYCLES_BEFORE_LAUNCH=200
+  TD_RUN_AFTER_POP_FAILS=0
C1 27 22 560u
X$D2 0 19 DIODE_SPICE_V2$1
H1 30 0 VH1$TP_CCVS 1 
VH1$TP_CCVS 19 20 0
H2 29 0 VH2$TP_CCVS 1 
VH2$TP_CCVS 21 0 0
I1 27 21 AC 10m 0
L1 20 27 600n
.PRINT V(#Vo)
.PRINT V(#io)
.GRAPH "db(:#Vo/:#io)" Curvelabel="Gain_Zo" nowarn=true yunit="dB" complete=True analysis="ac"
+ axisname=bodemag ylog=lin  persistence=0
.GRAPH "ph(-:#Vo/:#io)" Curvelabel="Phase_Zo" nowarn=true yunit="degrees" complete=True
+ analysis="ac"  axisname=bodephase ylog=lin  persistence=0
R1 27 0 100m
R2 22 0 6m
X$S1 19 26 28 0 SIMPLIS_VC_SWITCH$2
X$U1 28 24 0 31 25 SIMPLIS_DIGI1_COMP_Y$3
V1 26 0 12
V2 25 0 SAW V1=0 V2=1 FREQ=100000 DELAY=0 OFF_UNTIL_DELAY=NO
V3 31 0 0.1
X1 28 23 PERIODIC_OP$4
.subckt PERIODIC_OP$4  1 3
.NODE_MAP IN 1
.NODE_MAP OUT 3
!D_CYCLE 3 0 1 302 M1M IC=0
VREF 302 0 DC 2.5
.MODEL M1M COMP RIN=10MEG ROUT=50 VOL=0 VOH=5  HYSTWD=0.002 DELAY=0
.ends PERIODIC_OP$4

.subckt SIMPLIS_DIGI1_COMP_Y$3  201 202 100 101 102
.NODE_MAP OUT 201
.NODE_MAP OUT_BAR 202
.NODE_MAP RTN 100
.NODE_MAP INP 101
.NODE_MAP INN 102
R_INP  101 100 10000000
R_INN  102 100 10000000
E_DIFF 103 100 101 102 1.0
A_COMP %gnd_ref 100 [ 201 202 ] [ 103 ] MODEL=MD_A_COMPM IC=0
.MODEL MD_A_COMPM DIGITAL1 D_BUFFER ROUT=10 VOL=0 VOH=5  RIN=10000000 TH=0.0 HYSTWD=0.002
+  OUT_DELAY=2e-12
.ends SIMPLIS_DIGI1_COMP_Y$3

.subckt SIMPLIS_VC_SWITCH$2  1 2 3 4
.NODE_MAP P 1
.NODE_MAP N 2
.NODE_MAP CP 3
.NODE_MAP CN 4
S1 1 2 3 4 SW IC=OPEN
.MODEL SW VCSW ROFF=1000000 RON=1e-09 TH=2 HYSTWD=0.1 LOGIC=POS
.ends SIMPLIS_VC_SWITCH$2

.subckt DIODE_SPICE_V2$1  1 2
.NODE_MAP P 1
.NODE_MAP N 2
!R_DBODY 1 2 MRDM IC=1
.MODEL MRDM VPWLR  NSEG=3  X0=-50 Y0=-7.64712e-11  X1=0.000195833333333334  Y1=2.99512200000001e-16
*+ X2=0.0005 Y2=20
+ X2=0.000399989925448318  Y2=0.0979951642151925
+ X3=0.0005 Y3=20
.ends DIODE_SPICE_V2$1

.end

